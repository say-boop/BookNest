# PostgreSQL
POSTGRES_USER=name_user
POSTGRES_PASSWORD=your_secret_password
POSTGRES_DB=name_db
POSTGRES_HOST=host
POSTGRES_PORT=port

# Redis
REDIS_HOST=host
REDIS_PORT=port
REDIS_PASSWORD=your_secret_password
REDIS_DB=name_db

# RabbitMQ
RABBITMQ_DEFAULT_USER=name_user
RABBITMQ_DEFAULT_PASSWORD=your_secret_password
RABBITMQ_HOST=host
RABBITMQ_PORT=port

# JWT
SECRET_KEY=secret_key
ALGORITHM=algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=time_token